# Basic facts for every current sovereign state.
SELECT ?country ?iso3 ?iso2 ?countryLabel ?capitalLabel ?curCode ?curLabel ?continentLabel WHERE {
  ?country wdt:P31 wd:Q3624078 .
  FILTER NOT EXISTS { ?country wdt:P576 [] }
  OPTIONAL { ?country wdt:P298 ?iso3 . }
  OPTIONAL { ?country wdt:P297 ?iso2 . }
  OPTIONAL { ?country wdt:P36 ?capital . }
  OPTIONAL { ?country wdt:P38 ?cur . ?cur wdt:P498 ?curCode . }
  OPTIONAL { ?country wdt:P30 ?continent . }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". ?country rdfs:label ?countryLabel . ?capital rdfs:label ?capitalLabel . ?cur rdfs:label ?curLabel . ?continent rdfs:label ?continentLabel . }
}
